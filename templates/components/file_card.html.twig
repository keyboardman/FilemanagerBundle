<div class="card p-3">
	<div class="ratio ratio-16x9 mb-2">
		{% include '@KeyboardmanFilemanager/components/file_preview.html.twig' with {'file': file, 'filter': filter} %}
	</div>
	<h6 class="text-truncate">{{file.name}}</h6>
	<div class="d-flex gap-2 flex-wrap">
		<a href="{{ file.path|resolve_url(filter.filesystem) }}" class="btn btn-sm btn-success" download>
			<i class="bi bi-download"></i>
		</a>
		<button class="btn btn-sm btn-outline-secondary file-rename" data-path="{{ file.path }}" data-name="{{ file.name }}">
			<i class="bi bi-pencil"></i>
		</button>
		<button class="btn btn-sm btn-outline-danger file-delete" type="button" data-type="file" data-path="{{ file.path }}" data-name="{{ file.name }}">
			<i class="bi bi-trash"></i>
		</button>
		{% if filter.mode == 'iframe' or filter.target %}
			<button type="button" class="btn btn-sm btn-primary select-file-btn" data-path="{{ file.path|resolve_url(filter.filesystem, true) }}" data-target="{{ filter.target }}" title="Sélectionner">
				<i class="bi bi-hand-index-thumb"></i>
				<span class="d-none d-md-inline">Sélectionner</span>
			</button>
		{% endif %}
	</div>
</div>
