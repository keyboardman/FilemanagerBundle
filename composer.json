{
    "name": "keyboardman/filemanager-bundle",
    "version": "v0.1.0",
    "description": "Filemanager Bundle",
    "type": "symfony-bundle",
    "keywords": [
        "filemanager",
        "symfony",
        "flysystem"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Keyboardman",
            "email": "luc.moisan@gmail.com"
        }
    ],
    "homepage": "https://github.com/keyboardman/FilemanagerBundle",
    "support": {
        "source": "https://github.com/keyboardman/FilemanagerBundle",
        "issues": "https://github.com/keyboardman/FilemanagerBundle/issues"
    },
    "require": {
        "php": ">=8.2"
    },
    "suggest": {
        "symfony/ux-dropzone": "Interface dropzone Stimulus pour le filemanager (recommandé avec AssetMapper)"
    },
    "autoload": {
        "psr-4": {
            "Keyboardman\\FilemanagerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keyboardman\\FilemanagerBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "league/flysystem": "^3.0",
        "league/flysystem-memory": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^7.2|^8.0",
        "symfony/css-selector": "^7.2|^8.0",
        "symfony/framework-bundle": "^7.2|^8.0",
        "symfony/mime": "^7.2|^8.0",
        "symfony/phpunit-bridge": "^7.2|^8.0",
        "symfony/routing": "^7.2|^8.0",
        "symfony/yaml": "^7.2|^8.0",
        "symfony/form": "^7.4",
        "symfony/security-core": "^7.4",
        "twig/twig": "^3.27",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=512M"
    }
}
