{
    "name": "keyboardman/filemanager-bundle",
    "version": "v0.1.0",
    "description": "Filemanager Bundle",
    "type": "symfony-bundle",
    "keywords": [
        "filemanager",
        "symfony",
        "flysystem"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Keyboardman",
            "email": "luc.moisan@gmail.com"
        }
    ],
    "homepage": "https://github.com/keyboardman/FilemanagerBundle",
    "support": {
        "source": "https://github.com/keyboardman/FilemanagerBundle",
        "issues": "https://github.com/keyboardman/FilemanagerBundle/issues"
    },
    "require": {
        "php": ">=8.2",
        "symfony/asset-mapper": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Keyboardman\\FilemanagerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Keyboardman\\FilemanagerBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94"
    }
}