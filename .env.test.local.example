# Copiez ce fichier en .env.test.local ou pointez S3_CONTENT_ENV_FILE vers votre .env.local
# Ne commitez jamais les credentials.

S3_CONTENT_ENDPOINT=https://genese.example.com:8010
S3_CONTENT_ACCESS_KEY=your-access-key
S3_CONTENT_SECRET_KEY=your-secret-key
S3_CONTENT_BUCKET=WEBTV
S3_CONTENT_REGION=us-east-1
S3_CONTENT_PREFIX=
S3_CONTENT_SSL_VERIFY=false
